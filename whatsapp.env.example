# WhatsApp Cloud API / Business app coexistence bridge (never commit real secrets)
# Configure these on a PUBLIC HTTPS server, not in the APK or browser localStorage.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v26.0

# Meta webhook callback URL: https://YOUR_PUBLIC_HOST/webhook/whatsapp
# Subscribe the WhatsApp Business Account to the messages webhook field.
# Coexistence must be onboarded through an eligible Meta Tech Provider/Solution Partner.
# Keep WhatsApp Business App registered; do not delete/migrate the number unless you choose that path.
